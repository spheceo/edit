# Rust build output
/app/target/

# Bun workspace installs (root and every app/package)
node_modules/

# Web build output and the generated WASM engine
/app/apps/web/dist/
/app/apps/web/src/engine/pkg

# macOS metadata
.DS_Store

# Local caches (Wrangler's holds Cloudflare account details)
/app/apps/relay/.wrangler/
/app/apps/relay/.dev.vars
*.tsbuildinfo

# Tauri build output
/app/crates/edit-window/gen/

# The release binary's entry (apps/server/scripts/embed.ts writes it)
/app/apps/server/src/embedded.gen.ts

# Mood-board stills from other channels: kept locally, not published
/docs/moodboard/shots/
/.claude/worktrees/
/app/apps/relay/node_modules/
/app/packages/*/node_modules/

# The native addon (built by `just native`) and its tooling
/app/crates/edit-native/node_modules/
/app/crates/edit-native/*.node

# Release output (`just release`)
/app/package/

# Python worker tooling
__pycache__/
/app/apps/worker/.venv/
