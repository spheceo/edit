quickjs:
    #!/usr/bin/env bash
    host="$(rustc -vV | sed -n 's/^host: //p')"
    scripts/fetch-quickjs.sh "$host" "target/quickjs/$host"

# Release binary (package/edit) with the UI, addon and window helper embedded,
# as the release workflow builds it (doesn't update itself; see `publish`)
release: web (native "release") (window "release")
    #!/usr/bin/env bash
    set -euo pipefail
    target="${CARGO_TARGET_DIR:-target}"
    mkdir -p package
    bun apps/server/scripts/embed.ts --native crates/edit-native/edit-native.node --window "$target/release/edit-window"
    bun build apps/server/src/embedded.gen.ts --compile --outfile package/edit
    { [ "$(uname)" != Darwin ] || codesign -s - -f package/edit; }  # ad hoc: a Mac runs nothing unsigned
    echo "built package/edit"

# The dev server's binary: the Bun server compiled with the UI and the addon
# embedded (the addon in `[profile.serve]`: release speed, no LTO,
# incremental), without the desktop window, built on the internal disk
# (EDIT_BUILD_DIR, default ~/edit-build) and swapped into EDIT_SERVE_BIN
# (default /tmp/run/edit) by rename, so a running server isn't disturbed.
# Restart the server yourself. `just serve-build-bin` skips the UI rebuild.
serve-build: web serve-build-bin

# The trial server for the in-app agent's trials and the teaching loop (scripts/trial-server.sh):
# :7710, data in ~/.edit-trials, no bun --watch. start|stop|restart|status|code|log
trial-server *args:
    scripts/trial-server.sh {{args}}

serve-build-bin:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="${EDIT_BUILD_DIR:-$HOME/edit-build}"
    export CARGO_TARGET_DIR="$dir/target" CARGO_BUILD_BUILD_DIR="$dir/build"
    start=$SECONDS
    # The page's engine is edit-core and edit-render compiled to WASM: when
    # they (or the UI) changed since the UI was built, build it again. A page
    # checking projects with older rules than the server's showed one black.
    if [ ! -f apps/web/dist/index.html ] || [ -n "$(find crates/edit-core/src crates/edit-render/src crates/edit-wasm/src apps/web/src -type f -newer apps/web/dist/index.html | head -1)" ]; then
        (unset CARGO_TARGET_DIR CARGO_BUILD_BUILD_DIR; just web)
    fi
    (cd crates/edit-native && { [ -d node_modules ] || bun install --frozen-lockfile; } \
        && bunx napi build --profile serve --dts index.d.ts && { [ "$(uname)" != Darwin ] || codesign -s - -f edit-native.node; })
    bun apps/server/scripts/embed.ts --native crates/edit-native/edit-native.node
    dest="${EDIT_SERVE_BIN:-/tmp/run/edit}"
    mkdir -p "$(dirname "$dest")"
    bun build apps/server/src/embedded.gen.ts --compile --outfile "$dest.new"
    { [ "$(uname)" != Darwin ] || codesign -s - -f "$dest.new"; }  # ad hoc: a Mac runs nothing unsigned
    mv -f "$dest.new" "$dest"
    echo "built $dest in $((SECONDS - start)) s; restart the server to run it"

# Releases go up a patch at a time (v0.0.0, v0.0.1, …); in between, nightlies
# (nightly-1, nightly-2, …). GitHub Actions (.github/workflows/release.yml)
# builds the Apple Silicon Mac archives from the tag and publishes it.
# Only when the user says to make a new version; otherwise ship a nightly.
# Ship the next patch version (the current one if it was never released): check, bump, tag, push (CI builds and publishes)
publish: check
    #!/usr/bin/env bash
    set -euo pipefail
    [ "$(git branch --show-current)" = "main" ] || { echo "publish from main"; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "commit your changes first"; exit 1; }
    git fetch -q --tags origin
    current="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"
    if ! git rev-parse -q --verify "refs/tags/v$current" >/dev/null && ! gh release view "v$current" >/dev/null 2>&1; then
        # Never released (v0.0.0, the first): release it as it is.
        git tag "v$current"
        git push origin main "v$current"
        echo "Pushed v$current. GitHub Actions builds and publishes it (~10 min):"
        echo "  https://github.com/spheceo/edit/actions/workflows/release.yml"
        exit 0
    fi
    IFS=. read -r major minor patch <<<"$current"
    version="$major.$minor.$((patch + 1))"
    tag="v$version"
    if git rev-parse -q --verify "refs/tags/$tag" >/dev/null || gh release view "$tag" >/dev/null 2>&1; then
        echo "$tag already exists"
        exit 1
    fi
    # Put the version back if anything fails before the release commit.
    trap 'git checkout -- Cargo.toml Cargo.lock apps/web/package.json apps/server/package.json' ERR
    sed -i '' "s/^version = \"$current\"/version = \"$version\"/" Cargo.toml
    sed -i '' "s/\"version\": \"$current\"/\"version\": \"$version\"/" apps/web/package.json apps/server/package.json
    cargo update --workspace -q
    git commit -q -m "Release $tag" Cargo.toml Cargo.lock apps/web/package.json apps/server/package.json
    trap - ERR
    git tag "$tag"
    git push origin main "$tag"
    echo "Pushed $tag. GitHub Actions builds and publishes it (~10 min):"
    echo "  https://github.com/spheceo/edit/actions/workflows/release.yml"

# CI builds the tag and publishes it as a pre-release; installs on the Nightly
# channel (the default) offer it at the top of the editor.
# Ship a nightly: tag main's head nightly-<N> (the next number) and push.
# Checked first, like publish: a nightly reaches every install on the
# default channel, so it never ships on an unchecked tree. One a day at most
# (Sphe, Nov 8: sixteen in a week made the team the test suite): a second
# within 20 hours needs `--force "<why>"`, kept in the tag's message and the
# release's notes. The team's note (two lines, then every change by its plan
# item: scripts/nightly-notes.ts) is printed before tagging and becomes the
# pre-release's body. release.yml waits for Check on the tagged commit, Mac
# and Linux, and ships nothing past a red one, so a commit whose Check has
# already failed is refused here.
nightly *args:
    #!/usr/bin/env bash
    set -euo pipefail
    forced=""
    while [ $# -gt 0 ]; do
        case "$1" in
            # Everything after it is the reason (the top Justfile's forwarding splits a quoted one into words).
            --force) shift; forced="$*"; [ -n "$forced" ] || { echo 'just nightly --force "why it can'"'"'t wait"'; exit 1; }; break ;;
            *) echo 'just nightly [--force "why it can'"'"'t wait"]'; exit 1 ;;
        esac
    done
    [ "$(git branch --show-current)" = "main" ] || { echo "publish from main"; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "commit your changes first"; exit 1; }
    git fetch -q --tags origin
    last="$(git tag --list 'nightly-*' | sed 's/^nightly-//' | sort -n | tail -1)"
    if [ -n "$last" ]; then
        # When it was tagged (an annotated tag), else when GitHub published it, else its commit.
        at="$(git tag --list "nightly-$last" --format='%(taggerdate:unix)')"
        [ -n "$at" ] || at="$(gh release view "nightly-$last" --json publishedAt --jq '.publishedAt | fromdateiso8601' 2>/dev/null || true)"
        [ -n "$at" ] || at="$(git log -1 --format=%ct "nightly-$last")"
        hours=$(( ($(date +%s) - at) / 3600 ))
        if [ "$hours" -lt 20 ] && [ -z "$forced" ]; then
            echo "nightly-$last went out ${hours} h ago: one nightly a day at most."
            echo 'If this one can'"'"'t wait: just nightly --force "what it fixes, for whom"'
            exit 1
        fi
    fi
    # Check already failed on this commit (its push to main): it would never ship.
    sha="$(git rev-parse HEAD)"
    if [ "$(git rev-parse origin/main)" = "$sha" ]; then
        verdict="$(gh run list --workflow Check --commit "$sha" --event push --limit 1 --json conclusion --jq '.[0].conclusion // ""' 2>/dev/null || true)"
        if [ "$verdict" = failure ]; then
            echo "Check failed on $sha: fix it on main first (there is no override)."
            echo "  https://github.com/spheceo/edit/actions/workflows/check.yml"
            exit 1
        fi
    fi
    # No `just check` here: Check runs on the tagged commit in CI (the Mac and
    # Linux) and the release publishes only once it passes, building beside it
    # (Sphe, Nov 11: ten minutes here, then Check again, was too long).
    tag="nightly-$(( ${last:-0} + 1 ))"
    previous="$(git tag --list 'nightly-*' 'v*' --sort=-creatordate --merged HEAD | head -1)"
    echo
    echo "The team's note for $tag:"
    bun scripts/nightly-notes.ts "$previous" HEAD "$forced" | sed 's/^/  /'
    echo
    message="$tag"
    if [ -n "$forced" ]; then message="$(printf '%s\n\nForced: %s' "$tag" "$forced")"; fi
    git tag -a "$tag" -m "$message"
    git push origin main "$tag"
    echo "Pushed $tag. GitHub Actions waits for Check on it (Mac and Linux), then builds and publishes it (~10 min after):"
    echo "  https://github.com/spheceo/edit/actions/workflows/release.yml"

# The Bun server on :7700 (restarted on TS changes, and when the addon is
# rebuilt on engine changes) plus Vite with hot reload on :5173. Over
# Tailscale, open http://<machine>:5173 (redirects to HTTPS).
dev: wasm web-install (native "debug")
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p apps/web/dist
    source scripts/dev-env.sh
    # The server (scripts/dev-server.ts): a fresh one on each change to what it's made of (its source, the shared types,
    # agent/, the addon `just native` swaps in), started again when it exits or stops answering for a minute. It was
    # `bun --watch`, which reloads in one process and ran out of file handles after a day of reloads (EMFILE), hanging
    # with 7700 closed (Nov 2, 3, and three times on Nov 4).
    bun scripts/dev-server.ts &
    SERVER=$!
    # The engine and its bindings aren't rebuilt on every save any more: run `just native` after a Rust change and the
    # server restarts onto the new addon. A watch rebuilt it (debug) on every save of a Rust file, over the release
    # build other servers on this Mac were running (Nov 2: the trial server's Kroger export failed mid-chunk twice).
    # The browser engine shares edit-core/edit-render: rebuild it too (Vite reloads it).
    cargo watch -q --postpone -w crates/edit-core -w crates/edit-render -w crates/edit-wasm -s 'just wasm' &
    ENGINE=$!
    trap 'kill $SERVER $ENGINE 2>/dev/null || true' EXIT INT TERM
    bun run --cwd apps/web dev

# The dev server alone (:7700), as `just dev` runs it, for when Vite is already up or the server's loop went away
dev-server:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/dev-env.sh
    exec bun scripts/dev-server.ts

# Copy a prod cloud project into dev (scripts/copy_to_dev.py): `just copy-to-dev --list`, then `just copy-to-dev <id or name>`
copy-to-dev *args:
    @uv run -q --python 3.12 --with boto3==1.40.31 --with httpx python scripts/copy_to_dev.py {{args}}

# Format, lint and test
# oxlint with type-aware rules (.oxlintrc.json): the kinds of bug the
# typechecker misses (promises nobody awaits, a hook out of place, comparisons
# that can't be true). Errors fail; warnings are counted for clean-up.
lint:
    node_modules/.bin/oxlint --type-aware --tsconfig apps/server/tsconfig.json apps/server
    node_modules/.bin/oxlint --type-aware --tsconfig apps/web/tsconfig.json apps/web
    node_modules/.bin/oxlint apps/relay/src packages

# The Rust that's built here: everything, but the window helper only on a Mac
# (Linux's window is Chrome's, apps/server/src/linux_desktop.ts).
rust_crates := if os() == "macos" { "--workspace" } else { "--workspace --exclude edit-window" }

check: check-rust check-app

# Check's two halves, which CI runs as jobs side by side on each platform.
check-rust:
    cargo fmt --all --check
    cargo clippy {{rust_crates}} --all-targets -- -D warnings
    cargo test {{rust_crates}}
    cargo clippy -p edit-wasm --target wasm32-unknown-unknown -- -D warnings

# CI's Mac: what only a Mac can tell, the addon on AVFoundation and VideoToolbox and the server's tests on it,
# `shard` of them (1/2, 2/2: two jobs side by side; the first also tests the addon). One after another, not in
# parallel: on CI's three-core Mac, tests in parallel hung on the hardware encoder (Nov 11: two at 30 s, 224 s in
# all). The rest of check-app is the same TypeScript anywhere: Linux's Check runs it.
check-mac shard="1/1":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{shard}}" in 1/*) just native-test ;; *) just native debug ;; esac
    cd apps/server && bun test --timeout=30000 --timings=test/timings.json --shard={{shard}}

check-app: types
    # The generated TS types are committed: they must match the Rust.
    git diff --exit-code -- packages/edit-types
    test -z "$(git status --porcelain -- packages/edit-types)"
    just native-test
    # So is the addon's index.d.ts (napi writes it as it builds).
    git diff --exit-code -- crates/edit-native/index.d.ts
    bun run --cwd apps/web typecheck
    bun run --cwd apps/web test
    bun run --cwd apps/server typecheck
    just lint
    bun run --cwd apps/server test
